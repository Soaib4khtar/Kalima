# Local development only. Never commit real credentials.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=kalima
DB_USER=kalima_app
DB_PASSWORD=replace-me
PORT=5000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Quran Foundation Content API (server-only credentials).
# Prelive supports Al-Fatihah and Al-Baqarah. Resource IDs are environment-
# specific: select them from the same environment; do not copy example IDs.
QF_ENV=prelive
QF_CLIENT_ID=
QF_CLIENT_SECRET=
QF_TRANSLATION_ID=
# Optional ayah-by-ayah recitation ID from /resources/recitations.
QF_RECITATION_ID=

# Managed auth: public project URL only; use asymmetric Supabase signing keys.
# No service-role key or JWT signing secret is needed by this API.
SUPABASE_URL=
# Learning storage has no fallback to DB_* and cannot use the original kalima DB.
# npm run learning:db creates an ignored .env.learning.local automatically.
LEARNING_DATABASE_URL=
