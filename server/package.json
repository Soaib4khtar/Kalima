{
  "name": "kalima-server",
  "version": "1.0.0",
  "description": "Kalima backend API",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "test": "tsx --test --test-isolation=none tests/*.test.ts",
    "test:auth": "tsx --test --test-isolation=none tests/auth.test.ts tests/supabase-preflight.test.ts",
    "corpus:validate": "tsx src/modules/corpus/validate-corpus-file.ts",
    "quran:prelive-resources": "node scripts/qf-prelive-resources.mjs",
    "start": "node dist/server.js",
    "db:generate": "drizzle-kit generate",
    "learning:db": "node scripts/learning-db.mjs",
    "learning:migrate": "node scripts/learning-migrate.mjs",
    "db:migrate": "node scripts/refuse-legacy-migrate.mjs",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.3",
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.15.18": true,
    "es5-ext@0.10.64": true
  }
}
